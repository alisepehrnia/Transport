@using Trasnsport.WebUI.ViewModels.Account
@using Transport.Core.Constants
@using System.Web.Optimization

@model LoginViewModel

@{
	ViewBag.Title = "ورود";
	Layout = @"~/Views/Account/_LoginLayout.cshtml";
}

@using (Html.BeginForm("Login", "Account", new { ReturnUrl = ViewBag.ReturnUrl }, FormMethod.Post, new { @class = "form-horizontal", role = "form" }))
{
	@Html.AntiForgeryToken();

	@Html.Partial("_LoginBrandPartial")

<div class="login-box">
	<h4 class="text-center">ورود به حساب کاربری</h4>

	@Html.ValidationSummary(true, "", new { @class = "text-danger" })

	@{
		var labelClasses = "control-label login-input-label";
		var inputClasses = "form-control ltr";
		var validationMessageClasses = "text-danger text-small";
	}

	<div class="form-group">
		@Html.LabelFor(m => m.Email, new { @class = labelClasses })
		<div class="col">
			@Html.TextBoxFor(m => m.Email, new { @class = inputClasses })
			@Html.ValidationMessageFor(m => m.Email, "", new { @class = validationMessageClasses })
		</div>
	</div>

	<div class="form-group">
		@Html.LabelFor(m => m.Password, new { @class = labelClasses })
		<div class="col">
			@Html.PasswordFor(m => m.Password, new { @class = inputClasses })
			@Html.ValidationMessageFor(m => m.Password, "", new { @class = validationMessageClasses })
		</div>
	</div>

	<div class="form-group">
		<div class="checkbox">
			@Html.CheckBoxFor(m => m.RememberMe)
			@Html.LabelFor(m => m.RememberMe)
		</div>
	</div>

	<div class="form-group">
		<input type="submit" value="ورود" class="btn btn-primary btn-t-primary w-100" />
	</div>

	<div class="form-group">
		@Html.ActionLink("ساخت حساب کاربری جدید", "Register", "Account")
	</div>
</div>

	@Html.Partial("_LoginFooterPartial")
}