@using Transport.Core.Entities.User;
@using Transport.Core.Entities.Transport;
@using System.Linq.Expressions;

@model Transport.Core.Entities.Transport.TransportRequest

@{
	ViewBag.Title = "ثبت درخواست جدید";
}

<h2>@ViewBag.Title</h2>
<hr />

@using (Html.BeginForm())
{
	@Html.AntiForgeryToken()

	<div class="form-horizontal">

		@Html.ValidationSummary(true, "", new { @class = "text-danger" })

		@{
			var labelClasses = "control-label form-input-label";
			var inputClasses = "form-control ltr";
			var validationMessageClasses = "text-danger text-small";
		}

		<div class="form-group">
			@Html.LabelFor(model => model.TravelDateTime, htmlAttributes: new { @class = labelClasses })
			<div class="col-3">
				@Html.EditorFor(model => model.TravelDateTime, new { htmlAttributes = new { @class = inputClasses } })
				@Html.ValidationMessageFor(model => model.TravelDateTime, "", new { @class = validationMessageClasses })
			</div>
		</div>

		<div class="form-group">
			@Html.LabelFor(model => model.Address, htmlAttributes: new { @class = labelClasses })
			<div class="col-9">
				@Html.EditorFor(model => model.Address, new { htmlAttributes = new { @class = "form-control" } })
				@Html.ValidationMessageFor(model => model.Address, "", new { @class = validationMessageClasses })
			</div>
		</div>

		@if (ViewBag.OtherUsersListItems != null && ((IEnumerable<SelectListItem>)ViewBag.OtherUsersListItems).Any())
		{
			<div class="form-group">
				@Html.LabelFor(model => model.OtherUsers, htmlAttributes: new { @class = labelClasses })
				<div class="col-4">
					@{
						Expression<Func<TransportRequest, ICollection<AppUser>>> exp = model => model.OtherUsers;
						var lstBox = SelectExtensions.ListBoxFor<TransportRequest, ICollection<AppUser>>
								(Html, exp, ViewBag.OtherUsersListItems);

						@Html.Raw(lstBox)
					}
					@Html.ValidationMessageFor(model => model.OtherUsers, "", new { @class = validationMessageClasses })
				</div>
			</div>
		}

		<div class="form-group">
			<input type="submit" value="ثبت درخواست" class="btn btn-primary btn-t-primary" />
		</div>

		<div class="form-group">
			@Html.ActionLink("بازگشت به لیست درخواست‌ها", "Index")
		</div>
	</div>
}

@section Scripts {
	@Scripts.Render("~/bundles/jqueryval")
}
