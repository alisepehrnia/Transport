@model IEnumerable<Transport.Core.Entities.Transport.TransportRequest>

@{
	ViewBag.Title = "درخواست‌ها";
}

<div class="d-flex justify-content-between gap-2 mb-4">
	<h2>@ViewBag.Title</h2>

	<div>
		<a href="@Url.Action("Create")">
			<input value="+ درخواست جدید" type="button" class="btn btn-primary btn-t-primary btn-sm" />
		</a>
	</div>
</div>

<table class="table">
	<tr>
		<th>
			@Html.DisplayNameFor(model => model.RequestId)
		</th>
		<th>
			@Html.DisplayNameFor(model => model.DateTime)
		</th>
		<th>
			@Html.DisplayNameFor(model => model.TravelDateTime)
		</th>
		<th>
			@Html.DisplayNameFor(model => model.Address)
		</th>
		<th>
			@Html.DisplayNameFor(model => model.ConfirmState)
		</th>
		<th></th>
	</tr>

	@foreach (var item in Model)
	{
		<tr>
			<td>
				@Html.DisplayFor(modelItem => item.RequestId)
			</td>
			<td>
				@Html.DisplayFor(modelItem => item.DateTime)
			</td>
			<td>
				@Html.DisplayFor(modelItem => item.TravelDateTime)
			</td>
			<td>
				@Html.DisplayFor(modelItem => item.Address)
			</td>
			<td>
				@Html.DisplayFor(modelItem => item.ConfirmState)
			</td>
			<td>
				@*@Html.ActionLink("Edit", "Edit", new { id = item.RequestId }) |*@
				@Html.ActionLink("جزئیات", "Details", new { id = item.RequestId }) |
				@Html.ActionLink("حذف", "Delete", new { id = item.RequestId })
			</td>
		</tr>
	}

</table>
