@using Trasnsport.WebUI.ViewModels.Manage

@model IndexViewModel

@{
    ViewBag.Title = "مدیریت";
}

<h2>@ViewBag.Title</h2>

<p class="text-success">@ViewBag.StatusMessage</p>
<div>
    <h5>تغییر تنظیمات حساب کاربری</h5>
    <hr />
    <dl class="dl-horizontal">
        <dt>رمزعبور:</dt>
        <dd>
            [
            @if (Model.HasPassword)
						{
                @Html.ActionLink("رمزعبور خود را تغییر دهید", "ChangePassword")
						}
						else
						{
                @Html.ActionLink("ساخت رمزعبور", "SetPassword")
            }
            ]
        </dd>
        <dt>ورودها به حساب کاربری:</dt>
        <dd>
            @Model.Logins.Count
        </dd>
    </dl>
</div>
