@using Microsoft.AspNet.Identity

@{
	var dropdownItemClasses = "dropdown-item";
}

<div class="nav navbar-nav navbar-right">
	<div class="dropdown ltr">
		<a href="" class="dropdown-toggle" id="dropdownUser1" data-bs-toggle="dropdown" aria-expanded="false">
			<i class="bi bi-person-circle fs-2 mx-1"></i>
			@Html.Encode(User.Identity.GetUserName().Split('@')[0])
		</a>

		<ul class="dropdown-menu text-small" aria-labelledby="dropdownUser1">
			<li>@Html.ActionLink("سفر جدید...", "Request", controllerName: "Travel", routeValues: null, htmlAttributes: new { @class = dropdownItemClasses })</li>
			<li>@Html.ActionLink("پروفایل", "Index", controllerName: "Manage", routeValues: null, htmlAttributes: new { @class = dropdownItemClasses })</li>
			<li><hr class="dropdown-divider"></li>
			<li>
				@using (Html.BeginForm("LogOff", "Account", FormMethod.Post, new { id = "logoutForm", @class = "navbar-right" }))
				{
					@Html.AntiForgeryToken()
					<input type="submit" value="خروج" class="@dropdownItemClasses" />
				}
			</li>
		</ul>
	</div>
</div>